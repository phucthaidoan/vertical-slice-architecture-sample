@host = https://localhost:7219
@contentType = application/json

###
# Register a new user
POST {{host}}/auth/register
Content-Type: {{contentType}}

{
  "email": "user1@example.com",
  "password": "P@ssw0rd123",
  "userName": "demo-user1"
}

###
# Login and get JWT
POST {{host}}/auth/login
Content-Type: {{contentType}}

{
  "email": "admin@example.com",
  "password": "Admin123!"
}

###
# Set the bearer token manually after logging in
@token = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..QfC_C0XW-i2QVSUqMLv7MhiMal5eyQqGprJGf_UHAH4

###
# Get current user (requires Authorization header)
GET {{host}}/auth/me
Authorization: Bearer {{token}}

###
# Admin-only ping (requires user with Admin role)
GET {{host}}/auth/admin-ping
Authorization: Bearer {{token}}

